# ==============================================================================
# WILAYAH INDONESIA - CONFIGURATION TEMPLATE FOR DOKPLOY / DOCKER VPS DEPLOYMENT
# Copy file ini menjadi .env dan sesuaikan dengan environment VPS Anda di Dokploy
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=wilayah_db

# MinIO Object Storage Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=wilayah-logo

# Public URL for accessing logo images (Ubah ke IP VPS / Domain Dokploy Anda)
# Contoh Local/IP: http://localhost/wilayah-logo atau http://123.45.67.89/wilayah-logo
# Contoh Domain: https://api.yourdomain.com/wilayah-logo
MINIO_PUBLIC_URL=http://localhost/wilayah-logo

# NestJS REST API Configuration
PORT=3000

# React Frontend Configuration (Vite)
WEB_PORT=8080
# Biarkan kosong jika frontend & backend berjalan dalam satu server Dokploy via Nginx proxy
VITE_API_BASE_URL=
VITE_MINIO_PUBLIC_URL=

